{
    "name": "pm-electron-app",
    "version": "0.1.0",
    "private": true,
    "main": "main.js",
    "scripts": {
        "build-ui": "vite build",
        "start": "npm run build-ui && electron .",
        "dev-ui": "vite",
        "pack": "vite build && electron-builder --win",
        "dist": "vite build && electron-builder"
    },
    "build": {
        "appId": "com.pmapp.desktop",
        "productName": "Project Manager",
        "files": [
            "main.js",
            "preload.js",
            "db.js",
            "dist/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "portable",
            "forceCodeSigning": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sql.js": "^1.8.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.0.0",
        "electron": "^26.0.0",
        "electron-builder": "^26.7.0",
        "vite": "^5.0.0"
    }
}